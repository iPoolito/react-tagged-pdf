{
  "name": "react-tagged-pdf",
  "version": "0.0.0",
  "description": "Render React components to tagged, accessible PDF (PDF/UA-1).",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "fonts"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ua": "tsx scripts/test-ua.ts",
    "example": "tsx examples/hello.tsx",
    "example:headings": "tsx examples/headings.tsx",
    "example:pages": "tsx examples/pages.tsx",
    "example:inline": "tsx examples/inline.tsx",
    "example:lists": "tsx examples/lists.tsx",
    "example:images": "tsx examples/images.tsx"
  },
  "peerDependencies": {
    "react": "~19.3.0"
  },
  "dependencies": {
    "linebreak": "^2.0.0",
    "pdfkit": "^0.21.0",
    "react-reconciler": "0.34.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.3.0",
    "@types/react-reconciler": "^0.34.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
