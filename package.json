{
  "name": "react-tagged-pdf",
  "version": "0.0.2",
  "description": "Render React components to tagged, accessible PDF (PDF/UA-1).",
  "keywords": [
    "react",
    "pdf",
    "tagged-pdf",
    "pdf-ua",
    "accessibility",
    "a11y",
    "pdfkit",
    "verapdf"
  ],
  "homepage": "https://github.com/iPoolito/react-tagged-pdf#readme",
  "bugs": {
    "url": "https://github.com/iPoolito/react-tagged-pdf/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iPoolito/react-tagged-pdf.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "fonts/*.ttf",
    "fonts/OFL.txt"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ua": "tsx scripts/test-ua.ts",
    "example": "tsx examples/hello.tsx",
    "example:headings": "tsx examples/headings.tsx",
    "example:pages": "tsx examples/pages.tsx",
    "example:inline": "tsx examples/inline.tsx",
    "example:lists": "tsx examples/lists.tsx",
    "example:tables": "tsx examples/tables.tsx",
    "example:long-table": "tsx examples/long-table.tsx",
    "example:headers": "tsx examples/headers-footers.tsx",
    "example:images": "tsx examples/images.tsx",
    "prepack": "npm run build",
    "docs:examples": "tsx scripts/build-docs-examples.ts"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "linebreak": "^2.0.0",
    "pdfkit": "^0.21.0",
    "react-reconciler": "0.31.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.3.0",
    "@types/react-reconciler": "0.31.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "author": "Pool Ortega (https://github.com/iPoolito)"
}
